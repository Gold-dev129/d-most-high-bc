# =================================================================
# DMOSTHIGH CLOTHING BRAND BACKEND - ENVIRONMENT VARIABLES
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# For local MongoDB: mongodb://127.0.0.1:27017/dmosthigh
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dmosthigh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dmosthigh

# JSON Web Token (JWT) Authentication
# Generate a secure 64-character random string for production
JWT_SECRET=dmosthigh_super_secret_jwt_key_clothing_brand_2026
JWT_EXPIRES_IN=7d

# Cloudinary (Image Uploads & Storage)
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack Payment Gateway
# Obtain from https://dashboard.paystack.com/#/settings/developer
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Frontend Configuration (CORS allowed origin)
# Multiple origins can be comma-separated: http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# E-commerce Business Rules
# Shipping fee in Naira (NGN) - e.g. 2500 for N2,500
SHIPPING_FEE=2500
